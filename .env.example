# Copy this file to .env and fill in the values from App Store Connect.
# Keep .env private. It is ignored by git.

APP_STORE_CONNECT_API_KEY_ID=
APP_STORE_CONNECT_API_ISSUER_ID=
APP_STORE_CONNECT_API_KEY_PATH=$HOME/.private_keys/AuthKey_YOUR_KEY_ID.p8

# Optional: override which IPA fastlane uploads.
# VELO_IPA_PATH=/tmp/velo-tv-export-latest/Velo.ipa
